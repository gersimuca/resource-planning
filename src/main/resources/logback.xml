<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Environment variables are set in Openshift, make sure we have the correct values there if you want to enable ERP stash logging -->
    <property name="ERP_LOGGING_ENABLED" value="${ERP_LOGGING_ENABLED}" />

    <if condition='property("ERP_LOGGING_ENABLED").contains("true")'>
        <then>
            <appender name="stash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
                <destination>${ERP_LOGGING_REMOTE_HOST}:${ERP_LOGGING_REMOTE_PORT}</destination>
                <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                    <fieldNames>
                        <message>log-message</message>
                    </fieldNames>
                    <customFields>
                        {
                        "host": "${HOSTNAME}",
                        "appid": "${APP_ID}",
                        "namespace": "${ERP_LOGGING_NAMESPACE}",
                        "dealStage": "${ERP_LOGGING_STAGE}"
                        }
                    </customFields>
                </encoder>
            </appender>
            <root>
                <appender-ref ref="stash"/>
            </root>
        </then>
    </if>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{ISO8601} [%thread] traceId=%X{traceId:-} clientIp=%X{clientIp:-} %-6level %logger{36}:%line - %msg%n%ex{10}
            </pattern>
        </encoder>
    </appender>

    <root>
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="org.springframework.security" level="info" />
    <logger name="org.flywaydb" level="DEBUG"/>
</configuration>
